# Copie para .env.test e preencha antes de rodar `make secrets-test` /
# `make deploy-test`. Usado só pelo swarm-stack.test.yml (notebook de
# teste via SSH) — não confundir com .env (manage.py runserver direto) nem
# com .env.docker (stack de produção).
#
# Diferenças pro .env.docker.example: sem KOINONIA_DB_HOST/PORT (o
# koinonia-api usa um Postgres local no próprio stack de teste, não o
# Supabase), e os defaults já assumem acesso via localhost/SSH tunnel em
# vez de domínio público.

# ------------------------------------------------------------------
# URLs
#
# Cenário "notebook servidor + notebook do front": o front (koinonia-app /
# shepherds-toolkit-app) roda em OUTRO notebook e é aberto no navegador
# LOCALMENTE nesse notebook (ex.: http://localhost:5190) — por isso
# KOINONIA_FRONTEND_URL/SHEPHERDS_TOOLKIT_APP_URL e CORS_ALLOWED_ORIGINS
# continuam em localhost. Já KOINONIA_API_URL precisa ser o IP de rede
# local do notebook-servidor (onde este stack roda), porque é para lá que
# o NAVEGADOR do outro notebook é redirecionado (callback OAuth). Troque
# 192.168.1.76 pelo IP real do notebook-servidor se for diferente — é o
# mesmo IP já usado em VITE_API_URL nos .env.local dos dois frontends.
# ------------------------------------------------------------------
KOINONIA_FRONTEND_URL=http://localhost:5190
SHEPHERDS_TOOLKIT_APP_URL=http://localhost:5174
KOINONIA_API_URL=http://192.168.1.76:8001

# NÃO aponte isto para localhost/IP: é usado só em chamada
# backend-para-backend (koinonia-api -> shepherds-toolkit-api dentro do
# Swarm, apps/integrations/views.py), nunca pelo navegador. Deixe sem
# definir para herdar o default do swarm-stack.test.yml
# (http://shepherds-toolkit-api:8000, nome interno do serviço no Swarm) —
# setar para localhost:8002 aqui QUEBRA a integração entre as duas APIs,
# porque "localhost" dentro do container koinonia-api aponta pra ele mesmo.
# SHEPHERDS_TOOLKIT_API_URL=http://shepherds-toolkit-api:8000

# Inclui as duas portas padrão do `vite` (5173/5174, quando sobe sem
# --port) além das do convênio deste projeto (5190/5174), pra não levar
# CORS bloqueado de surpresa no primeiro `npm run dev`. Ajuste pra bater
# com a porta real que aparece no terminal do `npm run dev`.
CORS_ALLOWED_ORIGINS=http://localhost:5190,http://localhost:5174,http://localhost:5173
KOINONIA_ALLOWED_HOSTS=*
ST_ALLOWED_HOSTS=*

# Segredo compartilhado entre Koinonia-Api e shepherds-toolkit-api — pode
# ser um valor qualquer de teste, só precisa ser IDÊNTICO nos dois.
KOINONIA_CLIENT_SECRET=

# ------------------------------------------------------------------
# Koinonia-Api (este repo)
# ------------------------------------------------------------------
KOINONIA_SECRET_KEY=

# Por padrão usa o Postgres local do próprio stack (koinonia-db), pra não
# arriscar tocar em dado real durante teste. Pra apontar pro Supabase de
# verdade (idealmente um projeto separado de teste/dev, não produção),
# preencha KOINONIA_DB_HOST/PORT com os dados do Supabase e mude
# KOINONIA_DB_SSLMODE para "require" (Supabase exige SSL).
KOINONIA_DB_NAME=koinonia
KOINONIA_DB_USER=postgres
KOINONIA_DB_PASSWORD=
# KOINONIA_DB_HOST=
# KOINONIA_DB_PORT=5432
# KOINONIA_DB_SSLMODE=require

KOINONIA_FERNET_KEY=

KOINONIA_GOOGLE_CLIENT_ID=
KOINONIA_GOOGLE_CLIENT_SECRET=
# Redirect de navegador (Google manda o usuário de volta pra cá) — mesmo IP
# do notebook-servidor usado em KOINONIA_API_URL. Precisa estar cadastrado
# em "URIs de redirecionamento autorizados" no Google Cloud Console, senão
# o Google recusa com redirect_uri_mismatch.
KOINONIA_GOOGLE_REDIRECT_URI=http://192.168.1.76:8001/api/v1/integrations/google/callback/

# ------------------------------------------------------------------
# shepherds-toolkit-api (repo irmão, ../shepherds-toolkit-api)
# ------------------------------------------------------------------
ST_SECRET_KEY=
ST_DB_NAME=shepherd_toolkit
ST_DB_USER=postgres
ST_DB_PASSWORD=

ST_FIELD_ENCRYPTION_KEY=

ST_AUTH0_DOMAIN=
ST_AUTH0_CLIENT_ID=
ST_AUTH0_CLIENT_SECRET=
ST_AUTH0_MGMT_CLIENT_ID=
ST_AUTH0_MGMT_CLIENT_SECRET=

ST_GOOGLE_CLIENT_ID=
ST_GOOGLE_CLIENT_SECRET=

ST_OPENAI_API_KEY=

ST_STRIPE_SECRET_KEY=
ST_STRIPE_WEBHOOK_SECRET=
ST_STRIPE_PRICE_ID_PRO=
