# Copie para .env.docker e preencha antes de rodar `make secrets` / `make up`
# / `make deploy`. Não confundir com .env (usado pelo `manage.py runserver`
# direto, fora de container — formato de variáveis diferente, sem prefixo).
#
# Em produção (make deploy / swarm-stack.yml) estes valores só alimentam os
# Docker secrets — nunca ficam em texto puro no container. Em dev local
# (make up / docker-compose.yml) são injetados como env var mesmo.

# ------------------------------------------------------------------
# Domínios / URLs públicas
# ------------------------------------------------------------------
KOINONIA_FRONTEND_URL=https://app.koinonia.example.com
SHEPHERDS_TOOLKIT_APP_URL=https://app.shepherdstoolkit.example.com
KOINONIA_API_URL=https://api.koinonia.example.com
SHEPHERDS_TOOLKIT_API_URL=https://api.shepherdstoolkit.example.com
CORS_ALLOWED_ORIGINS=https://app.koinonia.example.com,https://app.shepherdstoolkit.example.com

# Segredo compartilhado entre Koinonia-Api e shepherds-toolkit-api para o
# mini-OAuth de vínculo de contas — precisa ser IDÊNTICO nos dois lados.
KOINONIA_CLIENT_SECRET=

# ------------------------------------------------------------------
# Koinonia-Api (este repo)
# ------------------------------------------------------------------
KOINONIA_SECRET_KEY=
KOINONIA_ALLOWED_HOSTS=api.koinonia.example.com

# Supabase (Settings > Database > Connection info do projeto)
KOINONIA_DB_NAME=postgres
KOINONIA_DB_USER=
KOINONIA_DB_PASSWORD=
KOINONIA_DB_HOST=
KOINONIA_DB_PORT=5432

# Chave Fernet p/ criptografar tokens em repouso (uazapi/OpenAI/Google/
# Shepherd's Toolkit). Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KOINONIA_FERNET_KEY=

# Google Calendar (OAuth) — app própria do Koinonia
KOINONIA_GOOGLE_CLIENT_ID=
KOINONIA_GOOGLE_CLIENT_SECRET=
KOINONIA_GOOGLE_REDIRECT_URI=https://api.koinonia.example.com/api/v1/integrations/google/callback/

# ------------------------------------------------------------------
# shepherds-toolkit-api (repo irmão, ../shepherds-toolkit-api)
# ------------------------------------------------------------------
ST_SECRET_KEY=
ST_ALLOWED_HOSTS=api.shepherdstoolkit.example.com

# Postgres próprio (container st-db neste stack, não é Supabase)
ST_DB_NAME=shepherd_toolkit
ST_DB_USER=postgres
ST_DB_PASSWORD=

# Chave Fernet p/ criptografar o refresh_token do Google em repouso.
ST_FIELD_ENCRYPTION_KEY=

# Auth0 (broker do login social Google, só para a integração de Calendar)
ST_AUTH0_DOMAIN=
ST_AUTH0_CLIENT_ID=
ST_AUTH0_CLIENT_SECRET=
ST_AUTH0_MGMT_CLIENT_ID=
ST_AUTH0_MGMT_CLIENT_SECRET=

# Google Calendar (mesmo OAuth Client configurado na conexão social do Auth0)
ST_GOOGLE_CLIENT_ID=
ST_GOOGLE_CLIENT_SECRET=

# IA (Caleb / geração de sermões etc.)
ST_OPENAI_API_KEY=

# Cobrança (opcional — deixe em branco se não usar Stripe ainda)
ST_STRIPE_SECRET_KEY=
ST_STRIPE_WEBHOOK_SECRET=
ST_STRIPE_PRICE_ID_PRO=

# ------------------------------------------------------------------
# Redis (broker do Celery do Koinonia-Api)
# ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
